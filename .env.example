# GitHub fine-grained token with Pull requests: read and Issues: write
GITHUB_TOKEN=
# Set a long random secret and use the same value in the GitHub webhook configuration
GITHUB_WEBHOOK_SECRET=change-this-to-a-long-random-secret
# Keep true until you have inspected review output. true = save preview, do not post.
DRY_RUN=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
MAX_FILES=20
MAX_PATCH_CHARS=30000
DATABASE_PATH=pr_guardian.db
